[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/network_lobby.gd" id="1_lobby"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.02, 0.065, 0.11, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
