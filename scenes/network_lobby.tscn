[node name="Join" type="Button" parent="Panel/Layout/Buttons"]
custom_minimum_size = Vector2(220, 46)
layout_mode = 2
text = "JOIN SERVER"

[node name="Status" type="Label" parent="Panel/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.82, 0.43, 1)
theme_override_font_sizes/font_size = 16
text = "READY"
horizontal_alignment = 1

[node name="Note" type="Label" parent="Panel/Layout"]
